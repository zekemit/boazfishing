# Copy to .env.local to override. Everything here is optional.

# Instructor passcode for /admin (default: boaz2026). Changing it signs everyone out.
ADMIN_PASSCODE=boaz2026

# Time zone Boaz works in (IANA name). Decides "today" and which same-day times have passed.
BUSINESS_TZ=America/New_York

# Where db.json and uploaded photos are stored. Use a persistent disk in production.
# BOAZ_DATA_DIR=/var/data/boaz

# Set to true BEFORE `npm run build` to hide the passcode hint in the login modal.
# NEXT_PUBLIC_HIDE_PASSCODE_HINT=true
