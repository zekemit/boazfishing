# Copy to .env.local (local) or add in Vercel > Settings > Environment Variables (live). Everything is optional.
# With nothing set, the site works and every email/alert is simulated and logged in Admin > Alerts.

# ---- Admin ----
ADMIN_PASSCODE=boaz2026
NEXT_PUBLIC_HIDE_PASSCODE_HINT=true
BUSINESS_TZ=America/New_York

# ---- Phone alerts to Boaz (free, no account): the ntfy app ----
# Install "ntfy" on the phone, subscribe to a long random topic name, and put the same name here.
NTFY_TOPIC=boaz-fishing-pick-a-long-random-name

# ---- Boaz's contact info (shown in student emails; also the text-message number) ----
BOAZ_PHONE=555-555-0100
BOAZ_EMAIL=you@gmail.com

# ---- Student emails (free): a Gmail app password ----
# Google Account > Security > 2-Step Verification > App passwords. Any SMTP host works (set SMTP_HOST/SMTP_PORT).
SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
# EMAIL_FROM="Boaz Fishing Co. <you@gmail.com>"

# ---- Optional extras ----
# Real text messages to Boaz via Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15555550100
# Also send every alert to this address (a carrier email-to-text address works too):
# BOAZ_ALERT_EMAIL=
# Tide station (default 8665530, Charleston Harbor):
# TIDE_STATION_ID=8665530

# ---- Scheduled reminders ----
# Vercel Cron calls /api/reminders daily and sends this secret automatically. Any long random string.
CRON_SECRET=
# Keep data somewhere persistent when self-hosting (Vercel uses Blob automatically):
# BOAZ_DATA_DIR=./data
# Seed the calendar without fake sample bookings:
# BOAZ_SEED_SAMPLES=false
